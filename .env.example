# HRFlow AI — Environment Configuration Example

# App Setup
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# Core Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hrflow_db
REDIS_URL=redis://localhost:6379/0

# Security Credentials
AUTH_SECRET=generate_a_secure_long_secret_here_for_nextauth
ENCRYPTION_KEY=generate_a_32_byte_hex_key_for_encrypting_employee_data

# AI Provider Settings (Supports gemini, openai, anthropic, or local-mock)
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-pro
AI_API_KEY=your_gemini_api_key_here

# Embeddings & Vector Search Settings
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_API_KEY=your_gemini_api_key_here
VECTOR_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hrflow_db

# Object Storage (For resumes, policies, and files)
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=hrflow-policy-vault

# Integrations Configuration
EMAIL_PROVIDER=mock
EMAIL_CLIENT_ID=mock_client_id
EMAIL_CLIENT_SECRET=mock_client_secret

# Observability
LOG_LEVEL=info
SENTRY_DSN=
